# Copie para um arquivo fora do Git e ajuste antes do deploy.
AZ_LOCATION=eastus
# Permite separar o MySQL quando a assinatura acadêmica não oferece capacidade
# na mesma região dos demais recursos.
AZ_MYSQL_LOCATION=
AZ_RESOURCE_GROUP=rg-predictfy-sprint3-substitua

# Nomes globais devem conter apenas letras/números minúsculos e ser únicos na Azure.
AZ_UNIQUE_SUFFIX=substitua
AZ_ACR_NAME=predictfysubstitua
AZ_MYSQL_SERVER=predictfy-substitua

AZ_CONTAINER_NAME=aci-predictfy-api
AZ_BRIDGE_CONTAINER_NAME=aci-predictfy-mysql-bridge
AZ_DNS_LABEL=predictfy-api-substitua
AZ_BRIDGE_DNS_LABEL=predictfy-bridge-substitua
AZ_LOG_WORKSPACE=log-predictfy-sprint3
AZ_APP_INSIGHTS=appi-predictfy-sprint3
AZ_MYSQL_DATABASE=predictfy
AZ_MYSQL_ADMIN=predictfyadmin

# Forneça no terminal; não salve valores reais neste arquivo.
MYSQL_ADMIN_PASSWORD=
CHAT_SESSION_SECRET=
OPENAI_API_KEY=
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=
CORS_ALLOWED_ORIGINS=
BRIDGE_API_KEY=
